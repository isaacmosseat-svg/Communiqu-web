<div class="font-mono text-sm sm:text-base md:text-lg opacity-80 min-h-[5em] max-w-2xl px-4 text-center">
  <span id="terminal-text"></span><span class="animate-pulse">_</span>
</div>

<script>
  const text = "Communiqué is a worker owned media project, built to support social movements and people's struggles internationally.";
  const terminalElement = document.getElementById('terminal-text');
  let index = 0;

  function type() {
    if (index < text.length) {
      terminalElement.textContent += text.charAt(index);
      index++;
      setTimeout(type, 40);
    } else {
      setTimeout(() => {
        terminalElement.textContent = "";
        index = 0;
        type();
      }, 7000); // Longer wait for readability
    }
  }

  if (terminalElement) {
    type();
  }
</script>
