<div class="font-mono text-sm sm:text-base md:text-lg opacity-80 mt-8 min-h-[4em] max-w-2xl px-4 text-center">
  <span id="terminal-text"></span><span class="animate-pulse">_</span>
</div>

<script>
  const text = "Communiqué is a worker owned media project, built to support social movements and people's struggles intentionally. coming soon.";
  const terminalElement = document.getElementById('terminal-text');
  let index = 0;

  function type() {
    if (index < text.length) {
      terminalElement.textContent += text.charAt(index);
      index++;
      setTimeout(type, 50);
    } else {
      setTimeout(() => {
        terminalElement.textContent = "";
        index = 0;
        type();
      }, 5000); // Wait 5 seconds before looping
    }
  }

  type();
</script>
